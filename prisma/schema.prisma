generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ELDER
  CAREGIVER
  ADMIN
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum GameCategory {
  COGNITIVE
  REMINISCENCE
  CULTURAL
  COMFORT
}

enum ReminderType {
  MEDICINE
  MEAL
  HYDRATION
  APPOINTMENT
  ACTIVITY
  COGNITIVE_SESSION
  PERSONAL
}

enum ReminderStatus {
  SCHEDULED
  COMPLETED
  SNOOZED
  MISSED
  ESCALATED
}

enum MemoryKind {
  PERSON
  PLACE
  STORY
  MUSIC
  CULTURAL
}

enum ActivityKind {
  GAME
  REMINDER
  MEMORY
  ASSISTANT
  SAFETY
}

model User {
  id                String                  @id @default(cuid())
  name              String?
  email             String?                 @unique
  emailVerified     DateTime?
  image             String?
  role              UserRole?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  caregiverLinks    CaregiverRelationship[] @relation("CaregiverLinks")
  elderLinks        CaregiverRelationship[] @relation("ElderLinks")
  createdReminders  Reminder[]              @relation("ReminderCreator")
  receivedReminders Reminder[]              @relation("ReminderElder")
  reminderEvents    ReminderEvent[]         @relation("ReminderEventActor")
  createdMemories   MemoryItem[]            @relation("MemoryCreator")
  ownedMemories     MemoryItem[]            @relation("MemoryOwner")
  gameSessions      GameSession[]
  activityLogs      ActivityLog[]
  safetyZones       SafetyZone[]
  locationEvents    LocationEvent[]
  emergencyContacts EmergencyContact[]
  notifications     Notification[]
  voiceMessages     VoiceMessage[]          @relation("VoiceMessageCreator")
}

model Profile {
  id                String                   @id @default(cuid())
  userId            String                   @unique
  displayName       String
  preferredLanguage String                   @default("en")
  timezone          String                   @default("Asia/Kolkata")
  photoUrl          String?
  consentLocation   Boolean                  @default(false)
  consentedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessibility     AccessibilityPreference?
}

model CaregiverRelationship {
  id          String             @id @default(cuid())
  caregiverId String
  elderId     String
  status      RelationshipStatus @default(PENDING)
  canView     Boolean            @default(true)
  canManage   Boolean            @default(false)
  canShare    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  caregiver   User               @relation("CaregiverLinks", fields: [caregiverId], references: [id], onDelete: Cascade)
  elder       User               @relation("ElderLinks", fields: [elderId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, elderId])
  @@index([elderId, status])
}

model Game {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  category     GameCategory
  focus        String
  instructions String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  sessions     GameSession[]
}

model GameSession {
  id          String      @id @default(cuid())
  userId      String
  gameId      String
  difficulty  Int
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Restrict)
  result      GameResult?

  @@index([userId, startedAt])
}

model GameResult {
  id               String      @id @default(cuid())
  sessionId        String      @unique
  accuracy         Float?
  completionTimeMs Int?
  mistakes         Int         @default(0)
  hintsUsed        Int         @default(0)
  attempts         Int         @default(1)
  completed        Boolean     @default(false)
  adaptiveDecision String?
  createdAt        DateTime    @default(now())
  session          GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Reminder {
  id                     String          @id @default(cuid())
  elderId                String
  createdById            String
  type                   ReminderType
  title                  String
  description            String?
  scheduledFor           DateTime
  repeatRule             String?
  visualAidUrl           String?
  audioUrl               String?
  escalationAfterMinutes Int             @default(30)
  escalationEnabled      Boolean         @default(true)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  elder                  User            @relation("ReminderElder", fields: [elderId], references: [id], onDelete: Cascade)
  createdBy              User            @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  events                 ReminderEvent[]

  @@index([elderId, scheduledFor])
}

model ReminderEvent {
  id         String         @id @default(cuid())
  reminderId String
  actorId    String?
  status     ReminderStatus
  occurredAt DateTime       @default(now())
  detail     String?
  reminder   Reminder       @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  actor      User?          @relation("ReminderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reminderId, occurredAt])
}

model MemoryItem {
  id           String     @id @default(cuid())
  ownerId      String
  createdById  String
  kind         MemoryKind
  title        String
  description  String?
  relationship String?
  mediaUrl     String?
  audioUrl     String?
  isApproved   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  owner        User       @relation("MemoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("MemoryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ownerId, kind])
}

model AccessibilityPreference {
  id              String  @id @default(cuid())
  profileId       String  @unique
  fontScale       String  @default("medium")
  theme           String  @default("light")
  highContrast    Boolean @default(false)
  reducedMotion   Boolean @default(false)
  audioAssistance Boolean @default(false)
  largeButtons    Boolean @default(true)
  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String
  kind       ActivityKind
  label      String
  metadata   Json?
  occurredAt DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model SafetyZone {
  id           String          @id @default(cuid())
  userId       String
  name         String
  latitude     Float
  longitude    Float
  radiusMetres Int
  enabled      Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       LocationEvent[]
}

model LocationEvent {
  id           String      @id @default(cuid())
  userId       String
  safetyZoneId String?
  latitude     Float
  longitude    Float
  occurredAt   DateTime    @default(now())
  eventType    String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  safetyZone   SafetyZone? @relation(fields: [safetyZoneId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String
  phone        String
  isSecondary  Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model VoiceMessage {
  id          String   @id @default(cuid())
  createdById String
  title       String
  audioUrl    String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("VoiceMessageCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
